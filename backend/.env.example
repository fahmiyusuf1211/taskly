# Salin jadi .env lalu isi nilainya. File .env JANGAN di-commit.
# Di server: /opt/taskly-api/.env dengan permission 600.

PORT=3000
NODE_ENV=production

# Postgres lokal di mesin yang sama (bind 127.0.0.1)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=taskly
DB_USER=taskly
DB_PASSWORD=isi-dengan-password-dari-/root/.taskly-dbpass
DB_POOL_MAX=8
